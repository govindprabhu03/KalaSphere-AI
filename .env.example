# ------------------------------------------------------------------
# Ravindra Bhavan platform — environment template
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored; this template is committed.
# ------------------------------------------------------------------

# Supabase project (Project Settings -> API in the Supabase dashboard)
# Public — safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME

# Server-only — NEVER expose to the browser. Bypasses Row-Level Security.
# Used by admin server code and the verify/seed scripts.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Public site URL (used for links, redirects, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Added in later phases (leave blank for now) ---
# Razorpay (Phase 2 — payments)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Google Gemini (Phase 8 — AI)
# GEMINI_API_KEY=
